// markdownlint default rules on the Markdown written for the rewrite.
// Legacy documents (docs/science, docs/system-spec.md, older specs and
// plans) are linted once they are rewritten.
{
  "config": {
    // Table rows and code blocks cannot be wrapped; prose keeps 80 columns.
    "MD013": { "tables": false, "code_blocks": false }
  },
  "globs": [
    "README.md",
    "CLAUDE.md",
    "crates/**/*.md",
    "tools/guardrails/**/*.md",
    "tools/stellar-grid/**/*.md",
    "tools/figures/**/*.md",
    ".claude/agents/*.md",
    "docs/superpowers/plans/2026-11-20-rewrite-*.md",
    "docs/science/SUMMARY.md",
    "docs/science/planet-interiors.md",
    "docs/science/system-architectures.md",
    "docs/science/star-structure.md",
    "docs/science/volcanoes.md",
    "docs/science/radiative-transfer.md",
    "docs/superpowers/plans/2026-11-21-planet-interior.md",
    "docs/superpowers/studies/2026-11-21-planet-interior/*.md",
    "docs/superpowers/specs/2026-11-21-planet-model-pr2*-design.md",
    "docs/superpowers/specs/2026-11-22-planet-model-pr2b-*-design.md",
    "docs/superpowers/plans/2026-11-22-planet-model-pr2b*.md",
    "docs/superpowers/plans/2026-11-23-planet-model-pr2c.md",
    "docs/superpowers/specs/2026-11-23-planet-model-pr2d-design.md",
    "docs/superpowers/plans/2026-11-23-planet-model-pr2d-*.md",
    "docs/superpowers/plans/2026-11-21-planet-model-2a.md",
    "docs/superpowers/studies/2026-11-21-planet-model-2a/*.md",
    "docs/superpowers/specs/2026-11-21-world-catalogue-design.md",
    "docs/superpowers/plans/2026-11-21-world-catalogue-*.md",
    "docs/superpowers/specs/2026-11-21-world-relief-design.md",
    "docs/superpowers/plans/2026-11-22-world-relief.md",
    "docs/superpowers/specs/2026-11-23-science-site-design.md",
    "docs/superpowers/plans/2026-11-23-science-site.md",
    "docs/superpowers/studies/2026-11-22-relief/*.md"
  ]
}
